{\n  \"name\": \"al-assistant\",\n  \"version\": \"2.0.0\",\n  \"description\": \"AL - 高级日常生活助手（含联网搜索、应用控制、安全防护）\",\n  \"main\": \"main.js\",\n  \"author\": \"HuMax1212\",\n  \"license\": \"MIT\",\n  \"scripts\": {\n    \"start\": \"electron .\",\n    \"dev\": \"electron . --dev\",\n    \"build\": \"electron-builder\",\n    \"build:win\": \"electron-builder --win --publish never\",\n    \"build:exe\": \"electron-builder --win nsis\"\n  },\n  \"devDependencies\": {\n    \"electron\": \"^latest\",\n    \"electron-builder\": \"^latest\"\n  },\n  \"dependencies\": {\n    \"axios\": \"^latest\",\n    \"dotenv\": \"^latest\",\n    \"child_process\": \"latest\",\n    \"crypto\": \"latest\"\n  },\n  \"build\": {\n    \"appId\": \"com.humax.al\",\n    \"productName\": \"AL 助手\",\n    \"files\": [\n      \"main.js\",\n      \"preload.js\",\n      \"security.js\",\n      \"api.js\",\n      \"index.html\",\n      \"styles.css\",\n      \"app.js\",\n      \"node_modules/**/*\"\n    ],\n    \"win\": {\n      \"target\": [\n        {\n          \"target\": \"nsis\",\n          \"arch\": [\"x64\"]\n        },\n        {\n          \"target\": \"portable\",\n          \"arch\": [\"x64\"]\n        }\n      ],\n      \"icon\": \"build/icon.ico\"\n    },\n    \"nsis\": {\n      \"oneClick\": false,\n      \"allowToChangeInstallationDirectory\": true,\n      \"createDesktopShortcut\": true,\n      \"createStartMenuShortcut\": true,\n      \"shortcutName\": \"AL 助手 v2.0\"\n    }\n  }\n}\n