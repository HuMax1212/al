{\n  \"name\": \"al-assistant\",\n  \"version\": \"1.0.0\",\n  \"description\": \"AL - 日常生活助手\",\n  \"main\": \"main.js\",\n  \"homepage\": \"./\",\n  \"homepage\": \"./\",\n  \"scripts\": {\n    \"start\": \"electron .\",\n    \"dev\": \"electron . --dev\",\n    \"build\": \"electron-builder\",\n    \"build:win\": \"electron-builder --win --publish never\",\n    \"build:exe\": \"electron-builder --win nsis\"\n  },\n  \"keywords\": [\n    \"daily assistant\",\n    \"todo\",\n    \"task management\"\n  ],\n  \"author\": \"HuMax1212\",\n  \"license\": \"MIT\",\n  \"devDependencies\": {\n    \"electron\": \"^latest\",\n    \"electron-builder\": \"^latest\"\n  },\n  \"build\": {\n    \"appId\": \"com.humax.al\",\n    \"productName\": \"AL 助手\",\n    \"files\": [\n      \"main.js\",\n      \"preload.js\",\n      \"index.html\",\n      \"styles.css\",\n      \"app.js\",\n      \"node_modules/**/*\"\n    ],\n    \"win\": {\n      \"target\": [\n        {\n          \"target\": \"nsis\",\n          \"arch\": [\n            \"x64\"\n          ]\n        },\n        {\n          \"target\": \"portable\",\n          \"arch\": [\n            \"x64\"\n          ]\n        }\n      ],\n      \"icon\": \"build/icon.ico\"\n    },\n    \"nsis\": {\n      \"oneClick\": false,\n      \"allowToChangeInstallationDirectory\": true,\n      \"createDesktopShortcut\": true,\n      \"createStartMenuShortcut\": true,\n      \"shortcutName\": \"AL 助手\"\n    }\n  }\n}\n